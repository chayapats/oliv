[Unit]
Description=OLIV api-tunnel with automatic recovery
StartLimitIntervalSec=0
Wants=oliv-api.service
After=oliv-api.service

[Service]
Type=forking
WorkingDirectory=%h/oliv
Environment=OLIV_SYSTEMD_LAUNCH=1 OLIV_HAVE_LOCK=1
ExecStart=%h/oliv/start.sh api-tunnel
ExecStartPost=/usr/bin/python3 %h/oliv/service_health.py api-tunnel
GuessMainPID=yes
Restart=always
RestartSec=5
TimeoutStartSec=150
TimeoutStopSec=20
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
