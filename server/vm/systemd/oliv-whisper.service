[Unit]
Description=OLIV whisper with automatic recovery
StartLimitIntervalSec=0

[Service]
Type=forking
WorkingDirectory=%h/oliv
Environment=OLIV_SYSTEMD_LAUNCH=1 OLIV_HAVE_LOCK=1
ExecStart=%h/oliv/start.sh whisper
ExecStartPost=/usr/bin/python3 %h/oliv/service_health.py whisper
PIDFile=%h/oliv/run/whisper.pid
Restart=always
RestartSec=5
TimeoutStartSec=150
TimeoutStopSec=20
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
