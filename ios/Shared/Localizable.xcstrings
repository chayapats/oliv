            "value": "ไม่ได้ยินเสียงพูด ไมโครโฟนปิดแล้ว และไม่มีอะไรถูกส่งออกไป"
          }
        }
      }
    },
    "No text remained.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อความเหลืออยู่"
          }
        }
      }
    },
    "No words yet. Start with your name or a project.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีคำ เริ่มจากชื่อคุณหรือชื่อโปรเจกต์ก็ได้"
          }
        }
      }
    },
    "Not synced (already there or Dictionary full): %@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
