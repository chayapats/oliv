        }
      }
    },
    "Nothing to copy": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรให้คัดลอก"
          }
        }
      }
    },
    "Nothing was copied. Try another recording when you’re ready.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรถูกคัดลอก พร้อมเมื่อไรก็ลองอัดเสียงใหม่ได้เลย"
          }
        }
      }
    },
    "Older rules · %lld": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กฎเก่า · %lld"
          }
        }
      }
    },
    "OLIV": {},
    "OLIV Capture": {},
    "OLIV KEYBOARD": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์บอร์ด OLIV"
          }
        }
      }
    },
    "OLIV Keyboard": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์บอร์ด OLIV"
          }
        }
      }
    },
    "OLIV could not complete the request (HTTP %lld). Your recording can be retried.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "OLIV ทำรายการไม่สำเร็จ (HTTP %lld) คุณลองส่งเสียงที่อัดไว้อีกครั้งได้"
          }
        }
      }
    },
    "OLIV could not finish this operation. Check available storage, microphone access, and your server connection.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "OLIV ทำรายการนี้ไม่สำเร็จ โปรดตรวจสอบพื้นที่เก็บข้อมูล การเข้าถึงไมโครโฟน และการเชื่อมต่อเซิร์ฟเวอร์"
          }
        }
      }
    },
    "OLIV could not finish this recording. Open the app to review or retry it.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "OLIV อัดเสียงนี้ไม่สำเร็จ เปิดแอปเพื่อตรวจสอบหรือลองใหม่"
          }
        }
      }
    },
    "OLIV expects 16 kHz mono 16-bit PCM WAV audio.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "OLIV ใช้ไฟล์เสียง PCM WAV แบบ 16 kHz โมโน 16 บิต"
          }
        }
      }
    },
    "OLIV is temporarily unavailable (HTTP %lld).%@ Your recording is preserved for retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "OLIV is temporarily unavailable (HTTP %1$lld).%2$@ Your recording is preserved for retry."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "OLIV ใช้งานไม่ได้ชั่วคราว (HTTP %lld)%@ เก็บเสียงที่อัดไว้ให้ลองใหม่แล้ว"
          }
        }
      }
    },
    "OLIV keyboard is ready": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์บอร์ด OLIV พร้อมใช้แล้ว"
          }
        }
      }
    },
    "OLIV now uses a public HTTPS API. Enter your new individual API key in Settings; your writing preferences and recordings were kept.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ OLIV ใช้ API แบบ HTTPS สาธารณะแล้ว โปรดใส่ API key ส่วนตัวอันใหม่ในการตั้งค่า การตั้งค่าการเขียนและเสียงที่อัดไว้ยังอยู่ครบ"
          }
        }
      }
    },
    "OLIV screen": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอ OLIV"
          }
        }
      }
    },
    "OLIV’s layout does not include Apple’s prediction, autocorrection or swipe typing. Automatic finish detects speech, not who is speaking; nearby voices can delay it. If no speech is detected, capture cancels after a short wait. Releasing the Action button does not stop recording.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์บอร์ด OLIV ไม่มีการคาดเดาคำ แก้คำอัตโนมัติ หรือปัดเพื่อพิมพ์แบบของ Apple หยุดอัตโนมัติจับแค่ว่ามีเสียงพูด ไม่ได้แยกว่าเสียงใคร เสียงคนรอบข้างอาจทำให้หยุดช้าลง ถ้าไม่ได้ยินเสียงพูด การอัดเสียงจะยกเลิกเองหลังรอสักครู่ และการปล่อยปุ่มแอ็คชั่นจะไม่หยุดอัดเสียง"
          }
        }
      }
    },
    "Oliv": {},
    "Oliv\nชื่อเฉพาะ\nYour project name": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Oliv\nชื่อเฉพาะ\nชื่อโปรเจกต์ของคุณ"
          }
        }
      }
    },
    "One gesture away": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีกแค่แตะเดียว"
          }
        }
      }
    },
    "Open Control Center, tap +, then Add a Control, and choose Toggle OLIV. Tap it whenever you want to speak.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดศูนย์ควบคุม แตะ + แล้วแตะเพิ่มส่วนควบคุม และเลือก Toggle OLIV อยากพูดเมื่อไรก็แตะได้เลย"
          }
        }
      }
    },
    "Open OLIV and copy the latest transcript, ready to paste into any app.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด OLIV แล้วคัดลอกข้อความล่าสุด พร้อมวางในแอปไหนก็ได้"
          }
        }
      }
    },
    "Open OLIV and immediately begin recording after setup is complete.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด OLIV แล้วเริ่มอัดเสียงทันทีเมื่อตั้งค่าเสร็จ"
          }
        }
      }
    },
    "Open OLIV and start recording.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด OLIV แล้วเริ่มอัดเสียง"
          }
        }
      }
    },
    "Open OLIV in that keyboard list and enable Allow Full Access. This lets the keyboard receive your requested transcript from the OLIV app. Ordinary typing stays on your iPhone.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ OLIV ในรายการแป้นพิมพ์นั้น แล้วเปิด อนุญาตการเข้าถึงทั้งหมด เพื่อให้คีย์บอร์ดรับข้อความที่คุณขอจากแอป OLIV ได้ ส่วนการพิมพ์ปกติจะอยู่แค่บน iPhone ของคุณ"
          }
        }
      }
    },
    "Open OLIV once to allow the microphone and Live Activities, then try again.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด OLIV หนึ่งครั้งเพื่ออนุญาตไมโครโฟนและ Live Activity แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Open OLIV once to finish setup, then try again.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด OLIV หนึ่งครั้งเพื่อตั้งค่าให้เสร็จ แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการตั้งค่า"
          }
        }
      }
    },
    "Opens Oliv and starts recording": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Oliv และเริ่มอัดเสียง"
          }
        }
      }
    },
    "Original": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้นฉบับ"
          }
        }
      }
    },
    "Passwords, some phone fields and apps that disallow third-party keyboards use the system keyboard. Background recording eligibility depends on iOS. Capture with OLIV opens the app to record; use Copy/Paste for that foreground route.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่องรหัสผ่าน ช่องเบอร์โทรบางช่อง และแอปที่ไม่อนุญาตคีย์บอร์ดอื่น จะใช้คีย์บอร์ดของระบบ การอัดเสียงในพื้นหลังทำได้หรือไม่ขึ้นอยู่กับ iOS ส่วน Capture with OLIV จะเปิดแอปขึ้นมาอัดเสียง ให้ใช้คัดลอก/วางเมื่ออัดด้วยวิธีนี้"
          }
        }
      }
    },
    "Paste into the app you’re using, with your usual keyboard.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางลงในแอปที่กำลังใช้ ด้วยคีย์บอร์ดเดิมของคุณ"
          }
        }
      }
    },
    "Paste or write something here.\nลองวางข้อความภาษาไทย หรือ English": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางหรือเขียนอะไรก็ได้ตรงนี้\nลองวางข้อความภาษาไทย หรือ English"
          }
        }
      }
    },
    "Paste text. Give it a little clarity.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางข้อความ แล้วเกลาให้ชัดขึ้นอีกนิด"
          }
        }
      }
    },
    "Preparing microphone…": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเตรียมไมโครโฟน…"
          }
        }
      }
    },
    "Preparing your microphone.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเตรียมไมโครโฟนของคุณ"
          }
        }
      }
    },
    "Press and hold the Action button once, or use your assigned Back Tap gesture. Wait for Listening, then speak. By default, OLIV finishes after 1.5 seconds without detected speech. Invoke again to finish sooner. Keep the same field and cursor for automatic draft insertion; OLIV does not send the message.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดปุ่มแอ็คชั่นค้างไว้หนึ่งครั้ง หรือใช้การแตะด้านหลังที่ตั้งไว้ รอจนขึ้นว่ากำลังฟัง แล้วพูดได้เลย โดยปกติ OLIV จะหยุดเองเมื่อไม่ได้ยินเสียงพูด 1.5 วินาที สั่งอีกครั้งถ้าอยากหยุดเร็วขึ้น อยู่ที่ช่องพิมพ์และเคอร์เซอร์เดิมเพื่อให้แทรกฉบับร่างอัตโนมัติ OLIV จะไม่ส่งข้อความให้"
          }
        }
      }
    },
    "Processing details": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายละเอียดการประมวลผล"
          }
        }
      }
    },
    "Processing details, %@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายละเอียดการประมวลผล, %@"
          }
        }
      }
    },
    "Quick access": {
      "localizations": {
