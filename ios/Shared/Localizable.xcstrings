{
  "sourceLanguage": "en",
  "strings": {
    "%@ characters": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ตัวอักษร"
          }
        }
      }
    },
    "%@ of %@ bytes. Shorten the text to clean it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ of %2$@ bytes. Shorten the text to clean it."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จาก %@ ไบต์ ย่อข้อความให้สั้นลงก่อนเกลา"
          }
        }
      }
    },
    "%lld percent": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld เปอร์เซ็นต์"
          }
        }
      }
    },
    "%lld sec of voice": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียง %lld วินาที"
          }
        }
      }
    },
    "%lld sec recording · %lld attempt%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld sec recording · %2$lld attempt%3$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัดเสียง %lld วินาที · ลอง %lld ครั้ง%@"
          }
        }
      }
    },
    "%lld words": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld คำ"
          }
        }
      }
    },
    "A Dictionary word can't hold these, like rules that write only symbols. They keep working on this iPhone.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พจนานุกรมเก็บรายการเหล่านี้ไม่ได้ เช่น กฎที่เขียนแค่สัญลักษณ์ แต่ยังใช้งานได้บน iPhone เครื่องนี้"
          }
        }
      }
    },
    "A few differences from Apple’s keyboard": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่างจากคีย์บอร์ดของ Apple นิดหน่อย"
          }
        }
      }
    },
    "A few iPhone realities": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อจำกัดบางอย่างของ iPhone"
          }
        }
      }
    },
    "A fresh page.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าใหม่ เริ่มได้เลย"
          }
        }
      }
    },
    "A little clarity.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกลาให้ชัดขึ้นอีกนิด"
          }
        }
      }
    },
    "A little less typing": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์น้อยลงอีกนิด"
          }
        }
      }
    },
    "A minimal keyboard, started with your Action button or Back Tap.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์บอร์ดเรียบง่าย เริ่มพูดได้ด้วยปุ่มแอ็คชั่นหรือการแตะด้านหลัง"
          }
        }
      }
    },
    "A moment\nfor your voice.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอเวลาสักครู่\nให้เสียงของคุณ"
          }
        }
      }
    },
    "A natural fit.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงตัวอย่างเป็นธรรมชาติ"
          }
        }
      }
    },
    "A place for your words": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่สำหรับคำพูดของคุณ"
          }
        }
      }
    },
    "A reliable starting point": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จุดเริ่มต้นที่ไว้ใจได้"
          }
        }
      }
    },
    "A second pass": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกลาอีกรอบ"
          }
        }
      }
    },
    "A simple Thai and English keyboard. Use the Action button to dictate without a microphone button taking over your keyboard.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์บอร์ดไทย-อังกฤษแบบเรียบง่าย ใช้ปุ่มแอ็คชั่นเพื่อพูดได้เลย โดยไม่มีปุ่มไมโครโฟนมาเกะกะบนคีย์บอร์ด"
          }
        }
      }
    },
    "A small setup. A smoother flow.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่านิดเดียว ใช้งานลื่นขึ้นเยอะ"
          }
        }
      }
    },
    "A thought,\nwell put.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกความคิด\nเรียบเรียงให้ลงตัว"
          }
        }
      }
    },
    "Add a word": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มคำ"
          }
        }
      }
    },
    "Add to Dictionary": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มลงในพจนานุกรม"
          }
        }
      }
    },
    "AI cleanup could not finish. Your words were preserved with OLIV’s deterministic cleanup.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AI เกลาข้อความไม่สำเร็จ แต่คำพูดของคุณยังอยู่ครบ OLIV เกลาให้แบบพื้นฐานแล้ว"
          }
        }
      }
    },
    "API token": {},
    "Access was denied. Ask the administrator to check the API key scopes and public API access policy.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้รับอนุญาตให้เข้าถึง โปรดให้ผู้ดูแลระบบตรวจสอบสิทธิ์ของ API key และนโยบายการเข้าถึง API สาธารณะ"
          }
        }
      }
    },
    "Action button": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มแอ็คชั่น"
          }
        }
      }
    },
    "Add Capture with OLIV to a shortcut, the Home Screen, or an available widget. Finish OLIV stops an existing recording without starting a new one.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม Capture with OLIV ลงใน Shortcuts หน้าจอโฮม หรือวิดเจ็ตที่รองรับ ส่วน Finish OLIV จะหยุดการอัดเสียงที่ทำอยู่ โดยไม่เริ่มอัดใหม่"
          }
        }
      }
    },
    "Add a replacement": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มคำแทนที่"
          }
        }
      }
    },
    "Add the OLIV keyboard so your words appear right where you're typing.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มคีย์บอร์ด OLIV เพื่อให้คำพูดของคุณไปปรากฏตรงที่กำลังพิมพ์"
          }
        }
      }
    },
    "All saved transcripts will be removed from this iPhone. This cannot be undone.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความที่บันทึกไว้ทั้งหมดจะถูกลบออกจาก iPhone เครื่องนี้ และกู้คืนไม่ได้"
          }
        }
      }
    },
    "Allow Full Access": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงทั้งหมด"
          }
        }
      }
    },
    "Allow microphone": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตไมโครโฟน"
          }
        }
      }
    },
    "Allow private HTTP": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาต HTTP ในเครือข่ายส่วนตัว"
          }
        }
      }
    },
    "Already have the words?": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีข้อความอยู่แล้วใช่ไหม"
          }
        }
      }
    },
    "An empty replacement removes the spoken phrase.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าเว้นคำแทนที่ไว้ คำที่พูดจะถูกตัดออก"
          }
        }
      }
    },
    "An interrupted recording is still waiting to be recovered. Relaunch OLIV before recording again.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังมีเสียงที่อัดค้างไว้รอการกู้คืน โปรดเปิด OLIV ใหม่ก่อนอัดเสียงอีกครั้ง"
          }
        }
      }
    },
    "An interrupted recording was incomplete and could not be retried. Its partial file was preserved. You can record again.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงที่อัดค้างไว้ไม่สมบูรณ์จึงลองใหม่ไม่ได้ แต่ไฟล์บางส่วนยังเก็บไว้อยู่ คุณอัดเสียงใหม่ได้เลย"
          }
        }
      }
    },
    "Any other iPhone": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone รุ่นอื่น"
          }
        }
      }
    },
    "Assign Toggle OLIV": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่า Toggle OLIV"
          }
        }
      }
    },
    "Audio goes to your configured Oliv server.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะถูกส่งไปที่เซิร์ฟเวอร์ Oliv ที่คุณตั้งค่าไว้"
          }
        }
      }
    },
    "Automatic finish became unavailable. The microphone is off and your audio is saved for retry. Nothing was inserted.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดอัตโนมัติใช้งานไม่ได้แล้ว ไมโครโฟนปิดอยู่และเก็บเสียงไว้ให้ลองใหม่ ยังไม่มีการแทรกข้อความ"
          }
        }
      }
    },
    "Automatic finish was unavailable. No request was sent.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดอัตโนมัติใช้งานไม่ได้ จึงยังไม่ได้ส่งคำขอ"
          }
        }
      }
    },
    "Automatic insertion needs the OLIV keyboard already active. Apple's keyboard still requires Paste. Secure and phone fields use the system keyboard, and some apps block custom keyboards.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแทรกข้อความอัตโนมัติต้องเปิดคีย์บอร์ด OLIV ไว้ก่อน ถ้าใช้คีย์บอร์ดของ Apple ยังต้องกดวางเอง ช่องรหัสผ่านและช่องเบอร์โทรจะใช้คีย์บอร์ดของระบบ และบางแอปไม่อนุญาตให้ใช้คีย์บอร์ดอื่น"
          }
        }
      }
    },
    "Built around your Oliv server": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกแบบมาให้ใช้กับเซิร์ฟเวอร์ Oliv ของคุณ"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิก"
          }
        }
      }
    },
    "Cancel OLIV": {},
    "Capture": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัดเสียง"
          }
        }
      }
    },
    "Capture with OLIV": {},
    "Checking…": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังตรวจสอบ…"
          }
        }
      }
    },
    "Clean text": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกลาข้อความ"
          }
        }
      }
    },
    "Cleanup": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกลาข้อความ"
          }
        }
      }
    },
    "Cleanup accepts up to %@ UTF-8 bytes of text; shorten it and try again.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกลาข้อความได้ไม่เกิน %@ ไบต์ UTF-8 ย่อให้สั้นลงแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Cleanup decision": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลการตัดสินใจเกลา"
          }
        }
      }
    },
    "Cloudflare denied this request. Contact the administrator with your OLIV app version.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare ปฏิเสธคำขอนี้ โปรดติดต่อผู้ดูแลระบบ พร้อมแจ้งเวอร์ชันแอป OLIV ของคุณ"
          }
        }
      }
    },
    "Come back, tap the box below, then hold the globe key and choose OLIV.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับมาที่นี่ แตะช่องด้านล่าง แล้วกดปุ่มลูกโลกค้างไว้และเลือก OLIV"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ"
          }
        }
      }
    },
    "Connect to start recording.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเพื่อเริ่มอัดเสียง"
          }
        }
      }
    },
    "Connect to your OLIV server.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อกับเซิร์ฟเวอร์ OLIV ของคุณ"
          }
        }
      }
    },
    "Connect your OLIV server and save its access token in Settings first.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ OLIV และบันทึกโทเคนเข้าถึงในการตั้งค่าก่อน"
          }
        }
      }
    },
    "Connect your Oliv server in Settings before cleaning text.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ Oliv ในการตั้งค่าก่อนเกลาข้อความ"
          }
        }
      }
    },
    "Connect your server and record once inside OLIV to allow microphone access. Toggle OLIV also requires Live Activities. If a background start fails, OLIV explains the problem without opening the app. Capture with OLIV is the separate action that opens it.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์แล้วอัดเสียงในแอป OLIV หนึ่งครั้งเพื่ออนุญาตไมโครโฟน Toggle OLIV ต้องเปิด Live Activity ด้วย ถ้าเริ่มอัดจากพื้นหลังไม่สำเร็จ OLIV จะแจ้งปัญหาโดยไม่เปิดแอป ส่วน Capture with OLIV เป็นอีกคำสั่งหนึ่งที่จะเปิดแอปขึ้นมา"
          }
        }
      }
    },
    "Connected, but this API key can't dictate. Ask the administrator to add the dictate scope.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อแล้ว แต่ API key นี้ใช้ถอดเสียงไม่ได้ ให้ผู้ดูแลเพิ่มสิทธิ์ dictate"
          }
        }
      }
    },
    "Connected. Your API key works.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อแล้ว API key ของคุณใช้งานได้"
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกแล้ว"
          }
        }
      }
    },
    "Copy Latest": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกล่าสุด"
          }
        }
      }
    },
    "Copy Latest OLIV": {},
    "Copy finished": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกฉบับเกลาแล้ว"
          }
        }
      }
    },
    "Copy finished text": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกข้อความที่เกลาแล้ว"
          }
        }
      }
    },
    "Copy text": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกข้อความ"
          }
        }
      }
    },
    "Copy the result, then paste it anywhere": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกข้อความ แล้ววางที่ไหนก็ได้"
          }
        }
      }
    },
    "Custom vocabulary, one phrase per line": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำศัพท์ของคุณ บรรทัดละหนึ่งคำหรือวลี"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ"
          }
        }
      }
    },
    "Delete all history": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบประวัติทั้งหมด"
          }
        }
