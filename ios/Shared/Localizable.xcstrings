          }
        }
      }
    },
    "Ready where you type": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร้อมใช้ตรงที่คุณพิมพ์"
          }
        }
      }
    },
    "Record another thought": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัดเสียงอีกครั้ง"
          }
        }
      }
    },
    "Record between a moment and two minutes of audio.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัดเสียงได้ตั้งแต่สั้นๆ จนถึงสองนาที"
          }
        }
      }
    },
    "Recording": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัดเสียง"
          }
        }
      }
    },
    "Recording duration": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลาอัดเสียง"
          }
        }
      }
    },
    "Recording duration, %@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลาอัดเสียง, %@"
          }
        }
      }
    },
    "Recording stopped because automatic finish became unavailable. Nothing was inserted. Open OLIV to review the recording.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดอัดเสียงแล้ว เพราะหยุดอัตโนมัติใช้งานไม่ได้ ยังไม่มีการแทรกข้อความ เปิด OLIV เพื่อตรวจสอบเสียงที่อัด"
          }
        }
      }
    },
    "Recordings are sent only to the server you configure. Failed recordings stay on this iPhone for retry. Finished audio is removed after processing; text history is optional.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะถูกส่งไปที่เซิร์ฟเวอร์ที่คุณตั้งค่าไว้เท่านั้น เสียงที่ส่งไม่สำเร็จจะเก็บไว้บน iPhone เครื่องนี้ให้ลองใหม่ เสียงที่ประมวลผลเสร็จแล้วจะถูกลบ ส่วนประวัติข้อความจะเก็บหรือไม่ก็ได้"
          }
        }
      }
    },
    "Recovered an interrupted recording. It is ready to retry.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนเสียงที่อัดค้างไว้แล้ว พร้อมให้ลองใหม่"
          }
        }
      }
    },
    "Remove rule": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบกฎ"
          }
        }
      }
    },
    "Replace spoken phrases with the text you prefer. Rules run from top to bottom.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนคำที่พูดเป็นคำที่คุณชอบ กฎจะทำงานจากบนลงล่าง"
          }
        }
      }
    },
    "Replacement rule %lld options": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกกฎคำแทนที่ข้อ %lld"
          }
        }
      }
    },
    "Replacement rules need a spoken phrase.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กฎคำแทนที่ต้องมีคำที่พูด"
          }
        }
      }
    },
    "Replacement text": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำแทนที่"
          }
        }
      }
    },
    "Replacements": {
