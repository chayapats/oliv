          }
        }
      }
    },
    "Ready for another try": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร้อมลองอีกครั้ง"
          }
        }
      }
    },
    "Ready for your next thought": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร้อมสำหรับความคิดต่อไปของคุณ"
          }
        }
      }
    },
    "Ready to use": {
