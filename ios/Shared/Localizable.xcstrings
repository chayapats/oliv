          "stringUnit": {
            "state": "translated",
            "value": "เข้าถึงด่วน"
          }
        }
      }
    },
    "Recognition hint": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยให้ถอดเสียงแม่นขึ้น"
          }
        }
      }
    },
    "Remove %@": {
      "localizations": {
