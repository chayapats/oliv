      }
    },
    "Names, products and terms OLIV should spell your way. Add what you say, or what OLIV mishears, to replace it with your word.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อคน ชื่อสินค้า และศัพท์เฉพาะที่อยากให้ OLIV สะกดแบบของคุณ ใส่สิ่งที่คุณพูดหรือคำที่ OLIV มักได้ยินผิด เพื่อให้แทนด้วยคำของคุณ"
          }
        }
      }
    },
    "Next": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถัดไป"
          }
        }
      }
    },
