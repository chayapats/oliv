      }
    },
    "Thai, English, or a little of both.\nYour words, with room to breathe.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไทย อังกฤษ หรือปนกันก็ได้\nพูดตามสบาย ไม่ต้องรีบ"
          }
        }
      }
    },
    "That recording was too short. Tap record and speak for at least a moment.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงที่อัดสั้นเกินไป แตะอัดเสียงแล้วพูดนานขึ้นอีกนิด"
          }
        }
      }
    },
    "That word is already in your Dictionary.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคำนี้ในพจนานุกรมแล้ว"
          }
        }
      }
    },
    "The API is busy or its quota was reached. Try again after %@. Your recording is preserved.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "API ไม่ว่างหรือใช้เกินโควตาแล้ว ลองอีกครั้งหลัง %@ เสียงที่อัดไว้ยังอยู่ครบ"
          }
        }
      }
    },
    "The API key is invalid, expired or revoked. Update it in Settings and retry.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "API key ไม่ถูกต้อง หมดอายุ หรือถูกยกเลิกแล้ว โปรดอัปเดตในการตั้งค่าแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "The PCM sample rate or recording size is invalid.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตราสุ่ม PCM หรือขนาดของเสียงที่อัดไม่ถูกต้อง"
          }
        }
      }
    },
    "The access token could not be read or saved securely. Unlock your iPhone and try again.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านหรือบันทึกโทเคนเข้าถึงอย่างปลอดภัยไม่ได้ โปรดปลดล็อก iPhone แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "The access token must contain printable ASCII characters without spaces.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทเคนเข้าถึงต้องเป็นอักขระ ASCII ที่แสดงผลได้ และไม่มีช่องว่าง"
          }
        }
      }
    },
    "The automatic finish timing is invalid.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาหยุดอัตโนมัติไม่ถูกต้อง"
          }
        }
      }
    },
    "The connection to OLIV failed. Your recording can be retried.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ OLIV ไม่สำเร็จ คุณลองส่งเสียงที่อัดไว้อีกครั้งได้"
          }
        }
      }
    },
    "The finishing touches": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บรายละเอียดอีกนิด"
          }
        }
      }
    },
    "The free trial is closed right now. Try again later.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ปิดรับทดลองใช้ฟรีอยู่ ลองใหม่ภายหลัง"
          }
        }
      }
    },
    "The keyboard focus is no longer valid.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์บอร์ดไม่ได้อยู่ที่ช่องพิมพ์เดิมแล้ว"
          }
        }
      }
    },
    "The keyboard handoff could not be read safely.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านข้อความที่ส่งต่อให้คีย์บอร์ดอย่างปลอดภัยไม่ได้"
          }
        }
      }
    },
    "The keyboard handoff exceeded its storage limit.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความที่ส่งต่อให้คีย์บอร์ดเกินพื้นที่ที่จำกัดไว้"
          }
        }
      }
    },
    "The microphone could not start. Check whether a call or another recording is using it.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มไมโครโฟนไม่ได้ ตรวจดูว่าสายโทรหรือการอัดเสียงอื่นกำลังใช้อยู่หรือไม่"
          }
        }
      }
    },
    "The microphone turns on only when you start a recording, and off as soon as you finish.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนเปิดเฉพาะตอนเริ่มอัดเสียง และปิดทันทีเมื่อคุณอัดเสร็จ"
          }
        }
      }
    },
    "The old shared token is retired. Enter a new individual API key in Settings and save it.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทเคนแบบใช้ร่วมกันอันเก่าเลิกใช้แล้ว โปรดใส่ API key ส่วนตัวอันใหม่ในการตั้งค่า แล้วบันทึก"
          }
        }
      }
    },
    "The original transcription, before cleanup and formatting.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความต้นฉบับก่อนเกลาและจัดรูปแบบ"
          }
        }
      }
    },
    "The recording is not a complete PCM WAV file.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงที่อัดไม่ใช่ไฟล์ PCM WAV ที่สมบูรณ์"
          }
        }
      }
    },
    "The request was cancelled.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกคำขอแล้ว"
          }
        }
      }
    },
    "The same core controls as the other OLIV clients.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกหลักเหมือนกับ OLIV เวอร์ชันอื่น"
          }
        }
      }
    },
    "The server answered but isn't ready. Try again in a moment.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ตอบกลับแล้วแต่ยังไม่พร้อม ลองอีกครั้งในอีกสักครู่"
          }
        }
      }
    },
    "The server could not be reached. Check your internet connection and retry.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ ตรวจสอบอินเทอร์เน็ตแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "The server returned an unreadable response. Check that the endpoint is an OLIV server.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ตอบกลับมาแบบอ่านไม่ได้ ตรวจสอบว่าที่อยู่นี้เป็นเซิร์ฟเวอร์ OLIV"
          }
        }
      }
    },
    "The server returned more data than expected.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ส่งข้อมูลกลับมามากเกินไป"
          }
        }
      }
    },
    "The server returned no finished text. Nothing was copied.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ไม่ได้ส่งข้อความกลับมา จึงไม่มีอะไรถูกคัดลอก"
          }
        }
      }
    },
    "The server took too long to respond. Your recording can be retried.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ตอบกลับช้าเกินไป คุณลองส่งเสียงที่อัดไว้อีกครั้งได้"
          }
        }
      }
    },
    "The shared keyboard storage is unavailable.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้พื้นที่เก็บข้อมูลร่วมของคีย์บอร์ดไม่ได้"
          }
        }
      }
    },
    "The spoken phrase needs up to %lld characters.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำพูดต้องยาวไม่เกิน %lld ตัวอักษร"
          }
        }
      }
    },
    "The text you submitted, before cleanup.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความที่คุณส่งมา ก่อนเกลา"
          }
        }
      }
    },
    "There is no transcript to copy yet. Record something in OLIV first.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีข้อความให้คัดลอก ลองอัดเสียงใน OLIV ก่อน"
          }
        }
      }
    },
    "These recordings are saved on this iPhone.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงเหล่านี้เก็บไว้บน iPhone เครื่องนี้"
          }
        }
      }
    },
    "This API key does not permit this operation. Ask the administrator for the required dictate or clean scope.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "API key นี้ไม่มีสิทธิ์ทำรายการนี้ โปรดขอสิทธิ์อัดเสียงหรือเกลาข้อความจากผู้ดูแลระบบ"
          }
        }
      }
    },
    "This audio will be removed from this iPhone.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงนี้จะถูกลบออกจาก iPhone เครื่องนี้"
          }
        }
      }
    },
    "This keyboard supports ordinary typing, Thai/English, shift, numbers, symbols, long-press accents and spacebar cursor movement. It does not include Apple’s predictive text, autocorrect or swipe-typing engine.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์บอร์ดนี้พิมพ์ได้ตามปกติ สลับไทย/อังกฤษได้ มีปุ่ม Shift ตัวเลข สัญลักษณ์ กดค้างเพื่อใส่เครื่องหมายเสียง และเลื่อนเคอร์เซอร์ด้วยปุ่มเว้นวรรค แต่ไม่มีการคาดเดาคำ แก้คำอัตโนมัติ หรือปัดเพื่อพิมพ์แบบของ Apple"
          }
        }
      }
    },
    "This OLIV server doesn't sync dictionaries yet. Your words still apply on this iPhone.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ OLIV นี้ยังไม่รองรับการซิงก์พจนานุกรม แต่คำของคุณยังใช้ได้บน iPhone เครื่องนี้"
          }
        }
      }
    },
    "This recording or its vocabulary exceeds the server's request limit.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงที่อัดหรือคำศัพท์เกินขีดจำกัดของเซิร์ฟเวอร์"
          }
        }
      }
    },
    "This result cannot be delivered through the keyboard.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งข้อความนี้ผ่านคีย์บอร์ดไม่ได้"
          }
        }
      }
    },
    "This saved recording is no longer available.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงที่บันทึกไว้นี้ไม่มีอยู่แล้ว"
          }
        }
      }
    },
    "This text will be sent to your configured Oliv server when you tap Clean text.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความนี้จะถูกส่งไปที่เซิร์ฟเวอร์ Oliv ที่คุณตั้งค่าไว้ เมื่อคุณแตะ เกลาข้อความ"
          }
        }
      }
    },
    "Tidy existing text with the same Dictionary and formatting you use for voice.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดข้อความที่มีอยู่ให้เรียบร้อย ด้วยพจนานุกรมและรูปแบบเดียวกับที่ใช้ตอนพูด"
          }
        }
      }
    },
    "Tidy existing text with the same vocabulary, replacements, and formatting you use for voice.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดข้อความที่มีอยู่ให้เรียบร้อย ด้วยคำศัพท์ คำแทนที่ และรูปแบบเดียวกับที่ใช้ตอนพูด"
          }
        }
      }
    },
    "Today's free trials are taken. Try again tomorrow.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์ทดลองใช้ฟรีของวันนี้หมดแล้ว ลองใหม่พรุ่งนี้"
          }
        }
      }
    },
    "Toggle OLIV": {},
    "Too many keyboard handoffs are pending. Try again shortly.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีข้อความรอส่งต่อให้คีย์บอร์ดมากเกินไป ลองอีกครั้งในอีกสักครู่"
          }
        }
      }
    },
    "Total processing": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาประมวลผลรวม"
          }
        }
      }
    },
    "Transcript version": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันข้อความ"
          }
        }
      }
    },
    "Transcription": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปลงเสียงเป็นข้อความ"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองอีกครั้ง"
          }
        }
      }
    },
    "Try another word or phrase from your transcript.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองค้นหาคำหรือวลีอื่นจากข้อความของคุณ"
          }
        }
      }
    },
    "Try it now": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองเลย"
          }
        }
      }
    },
    "Typing keeps the microphone off. Capture releases it before processing your words.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนพิมพ์ ไมโครโฟนจะปิดอยู่ และเมื่ออัดเสียงเสร็จ ไมโครโฟนจะปิดก่อนเริ่มประมวลผล"
          }
        }
      }
    },
    "Typing stays on your iPhone. Full Access only lets the keyboard receive text you dictated in OLIV.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่พิมพ์จะอยู่แค่บน iPhone ของคุณ การเข้าถึงทั้งหมดมีไว้ให้คีย์บอร์ดรับข้อความที่คุณพูดใน OLIV เท่านั้น"
          }
        }
      }
    },
    "Unstar %@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลิกติดดาว %@"
          }
        }
      }
    },
    "Use %@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ %@"
          }
        }
      }
    },
    "Use Capture with OLIV when opening the app suits your flow.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ Capture with OLIV เมื่อการเปิดแอปเหมาะกับการใช้งานของคุณ"
          }
        }
      }
    },
    "Use HTTPS, or explicitly enable HTTP for a local or private VPN address.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ HTTPS หรือเปิดอนุญาต HTTP สำหรับที่อยู่ในเครือข่ายภายในหรือ VPN ส่วนตัว"
          }
        }
      }
    },
    "Use it in every app": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ได้ในทุกแอป"
          }
        }
      }
    },
    "Use my own server or API key": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เซิร์ฟเวอร์หรือ API key ของฉันเอง"
          }
        }
      }
    },
    "Use the OLIV keyboard for automatic insertion, or keep your usual keyboard and paste. The microphone opens only when you start a capture.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้คีย์บอร์ด OLIV เพื่อแทรกข้อความอัตโนมัติ หรือใช้คีย์บอร์ดเดิมแล้ววางเอง ไมโครโฟนจะเปิดเฉพาะตอนที่คุณเริ่มอัดเสียง"
          }
        }
      }
    },
    "Use the keyboard switcher to choose OLIV. You can keep it selected for everyday Thai and English typing.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ปุ่มสลับคีย์บอร์ดเพื่อเลือก OLIV จะเลือกไว้ใช้พิมพ์ไทยและอังกฤษทุกวันเลยก็ได้"
          }
        }
      }
    },
    "Use the same capture gesture, then paste.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มอัดเสียงด้วยวิธีเดิม แล้ววางข้อความ"
          }
        }
      }
    },
    "Vocabulary allows at most %lld entries; remove %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Vocabulary allows at most %1$lld entries; remove %2$lld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำศัพท์มีได้ไม่เกิน %lld รายการ โปรดลบออก %lld รายการ"
          }
        }
      }
    },
    "Vocabulary corrections": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ตามคำศัพท์"
          }
        }
      }
    },
    "Voice waveform": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลื่นเสียง"
          }
        }
      }
    },
    "When I say (optional)": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อฉันพูดว่า (ไม่บังคับ)"
          }
        }
      }
    },
    "When I say (optional), e.g. กราฟาน่า": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อฉันพูดว่า (ไม่บังคับ) เช่น กราฟาน่า"
          }
        }
      }
    },
    "When you say “%@”": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณพูดว่า “%@”"
          }
        }
      }
    },
    "With OLIV selected in your field, press and hold the Action button once. Wait for Listening, speak, then pause. OLIV finishes after 1.5 seconds without detected speech. Invoke again to finish sooner. No speech cancels the capture after a short wait. The microphone stops before transcription and stays off while idle.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเลือก OLIV ในช่องพิมพ์แล้ว ให้กดปุ่มแอ็คชั่นค้างไว้หนึ่งครั้ง รอจนขึ้นว่ากำลังฟัง พูด แล้วเว้นจังหวะ OLIV จะหยุดเองเมื่อไม่ได้ยินเสียงพูด 1.5 วินาที สั่งอีกครั้งถ้าอยากหยุดเร็วขึ้น ถ้าไม่มีเสียงพูด การอัดเสียงจะยกเลิกเองหลังรอสักครู่ ไมโครโฟนจะหยุดก่อนแปลงเป็นข้อความ และปิดอยู่ตลอดเมื่อไม่ได้ใช้งาน"
          }
        }
      }
    },
    "Word": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำ"
          }
        }
      }
    },
    "Word, e.g. Grafana or บางแค": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำ เช่น Grafana หรือ บางแค"
          }
        }
      }
    },
    "Words OLIV should spell your way, and what to write when you say something. Shared with your other devices through your OLIV server.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำที่อยากให้ OLIV สะกดแบบของคุณ และสิ่งที่ให้เขียนเมื่อคุณพูดคำนั้น ใช้ร่วมกับเครื่องอื่นของคุณผ่านเซิร์ฟเวอร์ OLIV"
          }
        }
      }
    },
    "Words you use": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำที่คุณใช้"
          }
        }
      }
    },
    "Working on your words…": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเรียบเรียงข้อความ…"
          }
        }
      }
    },
    "Writing preferences": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าการเขียน"
          }
        }
      }
    },
    "Writing…": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเขียน…"
          }
        }
      }
    },
    "Your Dictionary": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พจนานุกรมของคุณ"
          }
        }
      }
    },
    "Your Dictionary could not be read, so new words can't be saved.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านพจนานุกรมไม่ได้ จึงบันทึกคำใหม่ไม่ได้"
          }
        }
      }
    },
    "Your Dictionary could not be read, so OLIV kept the file and isn't changing it. Dictation still works.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านพจนานุกรมไม่ได้ OLIV จึงเก็บไฟล์ไว้และไม่แก้ไขไฟล์นั้น แต่ยังพูดพิมพ์ได้ตามปกติ"
          }
        }
      }
    },
    "Your Dictionary could not be saved on this iPhone. %@": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกพจนานุกรมบน iPhone เครื่องนี้ไม่ได้ %@"
          }
        }
      }
    },
    "Your Dictionary is full. Remove a word to add another.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พจนานุกรมเต็มแล้ว ลบคำออกก่อนจึงจะเพิ่มคำใหม่ได้"
          }
        }
      }
    },
    "Your OLIV server doesn’t sync dictionaries yet. Your words still apply to every dictation.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ OLIV ของคุณยังไม่รองรับการซิงก์พจนานุกรม แต่คำของคุณยังใช้ได้ทุกครั้งที่พูด"
          }
        }
      }
    },
    "Your Oliv server is transcribing and applying your text preferences.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ Oliv ของคุณกำลังแปลงเสียงเป็นข้อความและจัดตามที่คุณตั้งค่าไว้"
          }
        }
      }
    },
    "Your connection": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อของคุณ"
          }
        }
      }
    },
    "Your finished dictations and cleaned text will appear here.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความที่อัดเสียงเสร็จและที่เกลาแล้วจะแสดงที่นี่"
          }
        }
      }
    },
    "Your free trial has ended. Tap to continue.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทดลองใช้ฟรีหมดแล้ว แตะเพื่อใช้ต่อ"
          }
        }
      }
    },
    "Your history.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติของคุณ"
          }
        }
      }
    },
    "Your keyboard.\nYour voice.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์บอร์ดของคุณ\nเสียงของคุณ"
          }
        }
      }
    },
    "Your server. Your vocabulary. Your way of writing.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ของคุณ คำศัพท์ของคุณ สไตล์การเขียนของคุณ"
          }
        }
      }
    },
    "Your text": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความของคุณ"
          }
        }
      }
    },
    "Your text is ready here. Automatic insertion was unavailable because the original keyboard field could not be confirmed. Copy the result to continue.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความของคุณพร้อมแล้วตรงนี้ แทรกอัตโนมัติไม่ได้เพราะยืนยันช่องพิมพ์เดิมไม่ได้ คัดลอกข้อความเพื่อใช้ต่อ"
          }
        }
      }
    },
    "Your text is ready here. OLIV could not connect to the active keyboard. Enable Allow Full Access for OLIV and keep the same field open when using Toggle OLIV.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความของคุณพร้อมแล้วตรงนี้ OLIV เชื่อมต่อกับคีย์บอร์ดที่เปิดอยู่ไม่ได้ โปรดเปิด อนุญาตการเข้าถึงทั้งหมด ให้ OLIV และเปิดช่องพิมพ์เดิมไว้ตอนใช้ Toggle OLIV"
          }
        }
      }
    },
    "Your voice, ready to use. Open OLIV and start recording.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงของคุณ พร้อมใช้งาน เปิด OLIV แล้วเริ่มอัดเสียงได้เลย"
          }
        }
      }
    },
    "Your words": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความของคุณ"
          }
        }
      }
    },
    "https://oliv.example.com": {},
    "iOS could not start OLIV’s Live Activity. Check iPhone Settings → Apps → OLIV → Live Activities, then try Toggle OLIV again.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS เริ่ม Live Activity ของ OLIV ไม่ได้ ตรวจสอบที่ การตั้งค่า iPhone → แอป → OLIV → Live Activity แล้วลอง Toggle OLIV อีกครั้ง"
          }
        }
      }
    },
    "iOS could not start the microphone. Recording did not begin. If a call or another recording is active, finish it before trying Toggle OLIV again.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS เริ่มไมโครโฟนไม่ได้ จึงยังไม่ได้อัดเสียง ถ้ามีสายโทรหรือการอัดเสียงอื่นอยู่ ให้จบก่อนแล้วลอง Toggle OLIV อีกครั้ง"
          }
        }
      }
    },
    "iPhone Settings → Action Button → swipe to Controls → Choose a Control → Toggle OLIV. By default, one press starts a capture that finishes after you pause.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า iPhone → ปุ่มแอ็คชั่น → ปัดไปที่ส่วนควบคุม → เลือกส่วนควบคุม → Toggle OLIV โดยปกติ กดหนึ่งครั้งเพื่อเริ่มอัดเสียง แล้วจะหยุดเองเมื่อคุณเว้นจังหวะ"
          }
        }
      }
    },
    "iPhone Settings → Action Button → swipe to Controls → Choose a Control → Toggle OLIV. On any other iPhone, add Toggle OLIV to Control Center. Leave Live Activities enabled for OLIV in iPhone Settings.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า iPhone → ปุ่มแอ็คชั่น → ปัดไปที่ส่วนควบคุม → เลือกส่วนควบคุม → Toggle OLIV ถ้าเป็น iPhone รุ่นอื่น ให้เพิ่ม Toggle OLIV ลงในศูนย์ควบคุม และเปิด Live Activity ของ OLIV ไว้ในการตั้งค่า iPhone"
          }
        }
      }
    },
    "iPhone Settings → Action Button → swipe to Controls → Choose a Control → Toggle OLIV. Then press and hold the button, speak, and pause.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า iPhone → ปุ่มแอ็คชั่น → ปัดไปที่ส่วนควบคุม → เลือกส่วนควบคุม → Toggle OLIV จากนั้นกดปุ่มค้างไว้ พูด แล้วเว้นจังหวะ"
          }
        }
      }
    },
    "iPhone Settings → General → Keyboard → Keyboards → Add New Keyboard → OLIV.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า iPhone → ทั่วไป → แป้นพิมพ์ → แป้นพิมพ์ → เพิ่มแป้นพิมพ์ใหม่ → OLIV"
          }
        }
      }
    },
    "iPhone Settings → General → Keyboard → Keyboards → Add New Keyboard → OLIV. Enable Allow Full Access so OLIV can hand the finished text to its keyboard. The keyboard does not send your typing to a server.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า iPhone → ทั่วไป → แป้นพิมพ์ → แป้นพิมพ์ → เพิ่มแป้นพิมพ์ใหม่ → OLIV เปิด อนุญาตการเข้าถึงทั้งหมด เพื่อให้ OLIV ส่งข้อความที่เสร็จแล้วไปยังคีย์บอร์ดได้ คีย์บอร์ดจะไม่ส่งสิ่งที่คุณพิมพ์ไปยังเซิร์ฟเวอร์"
          }
        }
      }
    },
    "oliv": {},
    "Your words · %lld": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำของคุณ · %lld"
          }
        }
      }
    },
    "โอลิฟ": {},
    "“พรุ่งนี้มี meeting ตอนสิบโมงนะครับ”": {}
  },
  "version": "1.0"
}
