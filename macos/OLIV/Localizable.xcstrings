      }
    },
    "CSV format: word,correction — one per line, up to %lld rows and 3MB. Rows without a correction become vocabulary words." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปแบบ CSV: word,correction บรรทัดละหนึ่งรายการ ไม่เกิน %lld แถวและ 3MB แถวที่ไม่มี correction จะเป็นคำศัพท์"
