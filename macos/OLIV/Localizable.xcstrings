          }
        }
      }
    },
    "You can close this and finish setup later from the menu › Setup…" : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดหน้าต่างนี้ได้ แล้วค่อยตั้งค่าต่อจากเมนู › ตั้งค่าเริ่มต้น…"
