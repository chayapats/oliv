    },
    "%@ — setup needed" : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — ต้องตั้งค่าเพิ่ม"
          }
        }
      }
    },
    "%@. %@" : {
      "shouldTranslate" : false
    },
    "%lld seconds" : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld วินาที"
          }
        }
      }
    },
    "%lld shown" : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดง %lld รายการ"
          }
        }
      }
    },
    "A Bluetooth mic switches headphone playback to mono call quality and may take a second to wake. Wait for the waveform before speaking." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไมโครโฟน Bluetooth จะทำให้หูฟังเปลี่ยนเป็นเสียงโมโนคุณภาพแบบโทรศัพท์ และอาจใช้เวลาสักวินาทีกว่าจะพร้อม รอให้คลื่นเสียงขึ้นก่อนเริ่มพูด"
          }
        }
      }
    },
    "A few small preferences. A smoother everyday workflow." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่านิดเดียว ใช้งานทุกวันได้ลื่นขึ้น"
          }
        }
      }
    },
    "A little history, only for this session." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประวัติสั้นๆ เฉพาะรอบการใช้งานนี้"
          }
        }
      }
    },
    "A quick way to take back a bad paste." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้อนข้อความที่วางผิดได้อย่างรวดเร็ว"
          }
        }
      }
    },
    "A second shortcut is optional. Either one can start a recording." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปุ่มลัดที่สองจะมีหรือไม่ก็ได้ ใช้ปุ่มไหนก็เริ่มอัดเสียงได้"
          }
        }
      }
    },
    "API access denied. Check key scope dictate or contact the administrator." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้รับอนุญาตให้ใช้ API ตรวจสอบว่า key มีสิทธิ์ dictate หรือติดต่อผู้ดูแลระบบ"
          }
        }
      }
    },
    "API cooldown — wait %lld seconds." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API ขอพักก่อน รออีก %lld วินาที"
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
