    },
    "Approve %@" : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุมัติ %@"
          }
        }
      }
    },
    "Audio & microphone" : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงและไมโครโฟน"
          }
        }
      }
    },
    "Audio is processed on this Mac. Works offline after downloading models." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประมวลผลเสียงบน Mac เครื่องนี้ ใช้ได้แม้ออฟไลน์หลังดาวน์โหลดโมเดลแล้ว"
          }
        }
      }
    },
    "Audio is sent to Groq for transcription. Cleanup, when enabled, runs on this Mac." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงจะถูกส่งไปที่ Groq เพื่อถอดเสียง ส่วนการเกลาข้อความ (ถ้าเปิดไว้) ทำบน Mac เครื่องนี้"
          }
        }
      }
    },
    "Audio is sent to Groq only while the Groq engine is selected. Local models are still needed for cleanup and fallback." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงจะถูกส่งไปที่ Groq เฉพาะตอนที่เลือกเอนจิน Groq ไว้ แต่ยังต้องมีโมเดลในเครื่องสำหรับเกลาข้อความและใช้สำรอง"
          }
        }
      }
    },
    "Audio is sent to OLIV API for transcription and cleanup." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงจะถูกส่งไปที่ OLIV API เพื่อถอดเสียงและเกลาข้อความ"
          }
        }
      }
    },
    "Audio is sent to your configured API for transcription and cleanup. Manage the URL and key, or check the connection, in Settings › Cloud services." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงจะถูกส่งไปที่ API ที่คุณตั้งค่าไว้เพื่อถอดเสียงและเกลาข้อความ จัดการ URL และ key หรือตรวจสอบการเชื่อมต่อได้ที่ การตั้งค่า › บริการคลาวด์"
          }
        }
      }
    },
    "Audio is sent to your configured server only when OLIV API is selected. Recordings are limited to 2 minutes. Failed requests aren’t resent automatically or saved for retry; rate limits may require a wait. Spoken formatting commands aren’t supported yet. Check connection tests server reachability, not your key or model readiness." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงจะถูกส่งไปที่เซิร์ฟเวอร์ที่คุณตั้งค่าไว้เฉพาะตอนที่เลือก OLIV API อัดเสียงได้ครั้งละไม่เกิน 2 นาที คำขอที่ไม่สำเร็จจะไม่ถูกส่งซ้ำอัตโนมัติและไม่ถูกเก็บไว้ให้ลองใหม่ ถ้าส่งถี่เกินไปอาจต้องรอสักพัก ยังไม่รองรับคำสั่งจัดรูปแบบด้วยเสียง ส่วน ตรวจสอบการเชื่อมต่อ จะทดสอบแค่ว่าติดต่อเซิร์ฟเวอร์ได้ ไม่ได้ตรวจ key หรือความพร้อมของโมเดล"
          }
        }
      }
    },
    "Audio is uploaded only when you select a cloud engine." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงจะถูกอัปโหลดเฉพาะเมื่อคุณเลือกเอนจินบนคลาวด์"
          }
        }
      }
    },
    "Audio stays on this Mac." : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงอยู่แค่บน Mac เครื่องนี้"
          }
        }
      }
    },
    "Auto-learn" : {
      "localizations" : {
        "th" : {
          "stringUnit" : {
            "state" : "translated",
